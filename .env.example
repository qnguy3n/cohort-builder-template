# Cohort Builder — local environment

# Path to the SQLite store written by the ml-processing-service pipeline.
# Default (if unset): ../ml-processing-service/_phi_local/olivo_poc.db
COHORT_DB_PATH=../ml-processing-service/_phi_local/olivo_poc.db

# Password that unlocks the live (real-EHR) institution in the hospital dropdown.
# REQUIRED for live access — there is no default; if unset, the live institution
# stays locked. Set the real value from 1Password, never commit it here.
LIVE_INSTITUTION_PASSWORD=change-me-in-1password

# Path to the DrChrono connection-status JSON written by the ingestion-service
# (scripts/check_access.py). Powers the "why is there no data" banner. Optional.
COHORT_STATUS_PATH=../.worktrees/ingestion-service/_phi_local/connection_status.json
